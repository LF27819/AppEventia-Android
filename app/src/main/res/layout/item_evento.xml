<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginTop="8dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeColor="#E0E0E0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:id="@+id/eventoNombreText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre del evento"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#212121"/>

        <TextView
            android:id="@+id/eventoCategoriaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Categoría"
            android:textSize="15sp"
            android:textColor="#666666"
            android:layout_marginTop="6dp"/>

        <TextView
            android:id="@+id/eventoFechaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fecha"
            android:textSize="15sp"
            android:textColor="#666666"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/eventoRecintoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recinto"
            android:textSize="15sp"
            android:textColor="#666666"
            android:layout_marginTop="4dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/editEventoButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/edit_event"
            android:layout_marginTop="16dp"
            app:cornerRadius="16dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/deleteEventoButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/delete"
            android:layout_marginTop="8dp"
            app:cornerRadius="16dp"
            style="@style/Widget.Material3.Button.OutlinedButton"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
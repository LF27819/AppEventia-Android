<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="12dp"
    card_view:cardCornerRadius="12dp"
    card_view:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/favoritoNombreText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre evento"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#212121"/>

        <TextView
            android:id="@+id/favoritoCategoriaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Categoría"
            android:textSize="15sp"
            android:textColor="#666666"
            android:layout_marginTop="6dp"/>

        <TextView
            android:id="@+id/favoritoFechaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fecha"
            android:textSize="15sp"
            android:layout_marginTop="4dp"/>

        <Button
            android:id="@+id/deleteFavoriteButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Eliminar"
            android:layout_marginTop="12dp"/>

        <TextView
            android:id="@+id/comentarioText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sin comentarios"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/editCommentButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Editar comentario"
            android:layout_marginTop="8dp"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>